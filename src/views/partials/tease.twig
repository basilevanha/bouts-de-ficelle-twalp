<article class="tease tease-{{post.type}}" id="tease-{{post.id}}">
	{% block main %}
		<div class="tease__img">
			<div class="tease__img-wrapper">
				{% if post.thumbnail %}
					<img class="" src="{{post.thumbnail.src}}" />
				{% endif %}
			</div>
		</div>
		<div class="tease__content">
			<h2 class="h2">{{ post.title }}</h2>
			{# <p>{{ dump(post) }}</p> #}
			{# <p>{{ dump(post.meta('description')) }}</p>
			<p>{{ post.description }}</p> #}
		</div>
	{% endblock %}
	<a class="tease__link" href="{{post.link}}"></a>
</article>