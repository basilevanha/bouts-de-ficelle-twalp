<article class="tease relative mb-12.5 flex flex-col overflow-hidden rounded-small bg-white shadow-[0_4px_4px_0_rgb(0_0_0/0.25)] m:flex-row" id="tease-{{post.id}}">
	{% block main %}
		<div class="m:w-[200px]">
			<div class="relative h-px w-full overflow-hidden bg-secondary pb-[56.25%]">
				{% if post.thumbnail %}
					<img class="absolute inset-0 size-full object-cover" src="{{post.thumbnail.src}}" />
				{% endif %}
			</div>
		</div>
		<div class="p-5">
			<h2 class="h2 text-[1.5625rem] font-bold">{{ post.title }}</h2>
		</div>
	{% endblock %}
	<a class="absolute top-0 left-0 size-full" href="{{post.link}}"></a>
</article>
