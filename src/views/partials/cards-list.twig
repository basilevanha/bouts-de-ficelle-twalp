{# Variables disponibles :
    {{ dump(cards) }}
    filters: ['string']
    layout: 'grid' | 'curve'
 #}

<div class="cards-list" x-data="{ filter: 'all' }">

    {% if filters %}
        {# The selected filter looks like a dark default button and can't be clicked again. #}
        {% set selected = 'data-[selected=true]:pointer-events-none data-[selected=true]:border-dark! data-[selected=true]:bg-dark! data-[selected=true]:text-light!' %}
        <div class="mb-12.5 flex flex-wrap justify-center gap-5">
            {% include 'components/button.twig' with {
                label: 'Tout',
                style: 'ghost',
                color: 'dark',
                pill: true,
                class: selected,
                datasAttributes: ['data-filter="all"', ':data-selected="filter === \'all\'"', '@click="filter = \'all\'"']
            } only %}

            {% for filter in filters %}
                {% include 'components/button.twig' with {
                    label: filter.label,
                    style: 'ghost',
                    color: 'dark',
                    pill: true,
                    class: selected,
                    datasAttributes: ['data-filter="' ~ filter.value ~ '"', ':data-selected="filter === \'' ~ filter.value ~ '\'"', '@click="filter = \'' ~ filter.value ~ '\'"']
                } only %}
            {% endfor %}
        </div>
    {% endif %}

    {# Default "shift" layout: on 3 columns (a card narrower than 40% of the
       list), the 1st card of each row goes up, the 3rd goes down. #}
    {% set layout = layout ?: 'shift' %}
    {% set shifts = {
        1: '@max-[40cqw]/card:-translate-y-[100px]',
        0: '@max-[40cqw]/card:translate-y-[100px]',
    } %}

    <div class="@container/cards grid gap-12.5 xs:grid-cols-[repeat(auto-fill,minmax(400px,1fr))] {{ layout == 'shift' ? 'min-[1360px]:py-[100px]' }}">

        {% for card in cards %}
            {% set datas = {
                img: card.thumbnail,
                title: card.title,
                description: card.description,
                btn: {
                    label: card.label,
                    href: card.link
                },
                showtype: card.showtype
            } %}

            <div class="@container/card" data-type="{{datas.showtype.value}}" x-show="filter === 'all' || filter === '{{ datas.showtype.value }}'">
                <div class="flex h-full {{ layout == 'shift' ? (shifts[loop.index % 3] ?? '') }}">
                    {% include 'modules/card.twig' with datas %}
                </div>
            </div>

        {% endfor %}
    </div>
</div>
