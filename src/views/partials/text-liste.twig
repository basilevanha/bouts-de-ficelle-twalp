{# Text + list of ateliers side by side (stacked below `l`)

    paragraphDatas: {}   — see modules/paragraph.twig
    items: []            — see modules/ateliers-liste.twig
    revert: bool         — list on the left (from `l`)
    class: string        — extra classes (spacing, background band…)
 #}

<div class="flex max-l:flex-col max-l:gap-12.5 l:items-center {{ revert ? 'l:flex-row-reverse' }} {{ class }}">
    <div class="l:flex-1 l:p-12.5">
        {% include 'modules/paragraph.twig' with paragraphDatas %}
    </div>

    <div class="flex flex-1 shrink-0 justify-center">
        {% include 'modules/ateliers-liste.twig' with items %}
    </div>
</div>
