<div class="offers-list">
    {% for card in offers %}
        {% set color = "primary" %}

        {% if loop.index == 2 %}
            {% set color = "secondary" %}
        {% endif %}

        {% if loop.index == 3 %}
            {% set color = "tertiary" %}
        {% endif %}

        {% set datas = {
            img: card.img,
            title: card.titre,
            price: card.prix,
            disclaimer: card.disclaimer,
            unit: card.unite,
            schedule: card.horaires,
            number: card.nombre,
            calendar: card.calendrier,
            btn: card.btn,
            color: color
        } %}
        
        <div class="offers-list__card-wrapper">
            {% include 'modules/offer-card.twig' with datas %}
        </div>

    {% endfor %}
</div>