{% set colors = ['primary', 'secondary', 'tertiary'] %}

<div class="grid gap-12.5 pt-5 pb-17.5 xs:grid-cols-[repeat(auto-fill,minmax(400px,1fr))]">
    {% for card in offers %}
        {% set datas = {
            img: card.img,
            title: card.titre,
            price: card.prix,
            disclaimer: card.disclaimer,
            unit: card.unite,
            schedule: card.horaires,
            number: card.nombre,
            calendar: card.calendrier,
            btn: card.btn,
            color: colors[loop.index0] ?? 'primary'
        } %}

        <div class="flex h-full">
            {% include 'modules/offer-card.twig' with datas %}
        </div>

    {% endfor %}
</div>
