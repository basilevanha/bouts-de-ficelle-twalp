{# 
    events: [post, ...]
#}

{% set pastevents = [] %}
{% set nextevents = [] %}

{% for event in events %}
    {% if ('now'|date('U') > event.end|date('U')) %}
        {% set pastevents = pastevents|merge([event]) %}
    {% endif %}
    {% if ('now'|date('U') < event.date|date('U')) %}
        {% set nextevents = nextevents|merge([event]) %}
    {% endif %}
{% endfor %}

<div class="editions">
    <h3 class="h3">Toutes les éditions :</h3>

    {% if nextevents is not empty %}
        <h4>À venir :</h4>
        <ul class="editions__list">
            {% for event in nextevents|reverse %}
                <li class="editions__item">
                    <span class="editions__item__date">
                        {{ event.date|date("d M y") }} : 
                    </span>
                    <a href="{{ event.url }}" class="a edition__item__link">
                        {{ event.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    
    {% if pastevents is not empty %}
        <h4>Archives :</h4>
        <ul class="editions__list">
            {% for event in pastevents %}
                <li class="editions__item">
                    <span class="editions__item__date">
                        {{ event.date|date("d M y") }} : 
                    </span>
                    <a href="{{ event.url }}" class="a edition__item__link">
                        {{ event.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>