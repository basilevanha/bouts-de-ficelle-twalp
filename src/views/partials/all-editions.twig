{# 
    events: [post, ...]
#}

{% set pastevents = [] %}
{% set nextevents = [] %}

{% for event in events %}
    {% if ('now'|date('U') > event.end|date('U')) %}
        {% set pastevents = pastevents|merge([event]) %}
    {% endif %}
    {% if ('now'|date('U') < event.date|date('U')) %}
        {% set nextevents = nextevents|merge([event]) %}
    {% endif %}
{% endfor %}

<div class="my-5 border-3 border-dark p-5">
    <h3 class="h3">Toutes les éditions :</h3>

    {% if nextevents is not empty %}
        <h4>À venir :</h4>
        <ul class="m-0">
            {% for event in nextevents|reverse %}
                <li>
                    <span>
                        {{ event.date|date("d M y") }} : 
                    </span>
                    <a href="{{ event.url }}" class="a">
                        {{ event.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
    
    {% if pastevents is not empty %}
        <h4>Archives :</h4>
        <ul class="m-0">
            {% for event in pastevents %}
                <li>
                    <span>
                        {{ event.date|date("d M y") }} : 
                    </span>
                    <a href="{{ event.url }}" class="a">
                        {{ event.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>