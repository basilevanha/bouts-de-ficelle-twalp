{% extends "layouts/base.twig" %}

{% set footerTone = 'dark' %}

{# Variables disponibles :
		{{ dump(hero) }}
		{{ dump(offres) }}
		{{ dump(gouts) }}
		{{ dump(spectacle) }}
 #}

{% set heroDatas = {
	paragraphDatas: {
		title: hero.titre,
		text: hero.texte,
		btns: [
			{
				label: hero.btn.label,
				url: hero.btn.url
			},
			{
				label: hero.btn2.label,
				url: hero.btn2.url
			}
		]
	},
	img: hero.img,
	ratioImg: 120
 } %}

 {% set offresDatas = {
	paragraphDatas: {
		title: offres.titre,
		text: offres.texte,
	},
	img: offres.img,
	revert: true,
	ratioImg: 120
 } %}

 {% set goutsDatas = {
	paragraphDatas: {
		title: gouts.titre,
		text: gouts.texte,
	},
	img: gouts.img
 } %}

  {% set stagesDatas = {
	paragraphDatas: {
		title: stages.titre,
		text: stages.texte,
	},
	img: stages.img,
	revert: true
 } %}

  {% set spectacleDatas = {
	paragraphDatas: {
		title: spectacle.titre,
		text: spectacle.texte,
	},
	img: spectacle.img,
 } %}

{% block main %}

	<div class="container" id="post-{{post.ID}}">

		{# {% if (global.highlight.toggle == true) %}
			{% include 'modules/highlight.twig' with {event: global.highlight} %}
		{% endif %} #}

		<div class="mb-[120px]">
			{% include 'partials/image-text.twig' with heroDatas %}
		</div>

		<div class="band pt-12.5 before:h-[140%] before:bg-soft-primary">
			{% include 'partials/image-text.twig' with offresDatas %}
		</div>

		<div>
			{% include 'partials/offers-list.twig' with { offers: offres.cartes } %}
		</div>

		{% if gouts.titre %}
			<div class="band py-[120px] before:h-full before:bg-soft-secondary">
				{% include 'partials/image-text.twig' with goutsDatas %}
			</div>
		{% endif %}

		{% if stages.titre %}
			<div>
				{% include 'partials/image-text.twig' with stagesDatas %}
			</div>
		{% endif %}

		{% if spectacle.titre %}
			<div class="band py-[120px] before:h-full before:bg-soft-dark">
				{% include 'partials/image-text.twig' with spectacleDatas %}
			</div>
		{% endif %}
	</div>
	<!-- /content-wrapper -->
{% endblock %}