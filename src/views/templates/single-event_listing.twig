{% extends "layouts/base.twig" %}

{% block main %}
	<article class="container" id="post-{{ post.ID }}">
		<div class="mx-auto mt-5 mb-17.5 max-w-[1250px]">
			<div class="text-[1rem] font-bold">
				<a class="a" id="event-breadcrumb-events" href="{{ site.link }}/calendrier">Calendrier</a>
				>
				{{ post.name }}
			</div>
			<div class="mt-5 w-full max-m:-mx-5 max-m:w-screen">
				{% include 'atoms/image.twig' with {img: {
					src: post.thumbnail,
					alt: post.title,
					ratio: 'widescreen'
				}} %}
			</div>

			<div class="typeset relative -mt-17.5 p-5 max-m:p-0">

				<div class="rounded-small bg-soft-dark px-5 pt-2.5 pb-5 desktop:p-5">
					<h1 class="mb-5 max-m:text-[30px]">{{ post.title }}</h1>
					<p class="flex flex-wrap gap-2.5 m:m-0!">
						{{ icon('time', 'mt-2 size-[25px]') }}
						<strong>Début:</strong> <span class="value">{{ infos.start|date("d F \\à\\ H:i") }}</span>
					</p>
					<p class="flex flex-wrap gap-2.5 m:m-0!">
						{{ icon('time', 'mt-2 size-[25px]') }}
						<strong>Fin:</strong> <span class="value">{{ infos.end|date("d F \\à\\ H:i") }}</span>
					</p>
					<p class="flex flex-wrap gap-2.5 m:m-0!">
                		{{ icon('localisation', 'mt-2 size-[25px]') }}
						<strong>Lieu:</strong>
						<span class="value">
						<a
							class="a m-0 p-0"
							href="https://www.google.com/maps/search/?api=1&query={{ infos.location|url_encode }}"
							target="_blank"
							id="event-location-on-google-maps"
						> {{ infos.location }}</a>
						</span>
					</p>

					{% if reservation %}
						{% include 'modules/modal.twig' with {
							label: "Réserver",
							id: "Réservation",
							title: "Réserver sa place",
							description: "Formulaire de réservation",
							buttonClass: "mt-5",
							modalcontent: isBillable ? registrationForm|raw : registrationFormFree|raw
						} %}
					{% endif %}
				</div>

				{{ content }}

				{% if typeEvent %}
					<h5>Tags : </h5>
					<ul class="m-0 flex flex-wrap gap-5 pt-5 pr-5 pb-12.5 pl-0">
						<li class="before:hidden">
							{% include 'components/button.twig' with {
								label: typeEvent,
								href: typeEvent == "atelier" ? ateliersURL : spectaclesURL,
								style: 'neg',
								color: 'dark',
								tag: true
							} only %}
						</li>
						<li class="before:hidden">
							{% include 'components/button.twig' with {
								label: typeName,
								href: typeURL,
								style: 'neg',
								color: 'dark',
								tag: true
							} only %}
						</li>
					</ul>
				{% endif %}

			</div>

			
		</div>
	</article>
{% endblock %}
