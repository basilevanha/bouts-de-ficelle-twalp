{% extends "layouts/base.twig" %}

{% block main %}
	<article class="single-atelier container post-type-{{ post.post_type }}" id="post-{{ post.ID }}">

		<div class="single-atelier__hero">
			{% include 'atoms/image.twig' with {img: {
				src: post.cover.url,
				alt: post.title,
				ratio: 'banner'
			}} %}

			<div class="single-atelier__hero__breadcrumb">
				<a class="a" id="atelier-breadcrumb-home" href="{{ site.link }}">Accueil</a>
				>
				<a class="a" id="atelier-breadcrumb-ateliers" href="{{ global.pageAteliers.link }}">{{ global.pageAteliers.title }}</a>
				>
				{{ post.name }}
			</div>
		</div>

		<div class="single-atelier__content typeset">
			<h1>{{ post.title }}</h1>


			{{ post.content }}
			
			{% if evenements is not empty %}
				{% include 'partials/all-editions.twig' with {events: evenements} %}
			{% endif %}
		</div>

		
	</article>
{% endblock %}
