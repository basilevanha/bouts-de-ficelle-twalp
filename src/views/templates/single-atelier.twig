{% extends "layouts/base.twig" %}

{% block main %}
	<article class="container" id="post-{{ post.ID }}">

		<div class="mx-auto w-full max-w-[900px]">
			{% include 'atoms/image.twig' with {img: {
				src: post.cover.url,
				alt: post.title,
				ratio: 'banner'
			}} %}

			<div class="text-[1rem] font-bold">
				<a class="a" id="atelier-breadcrumb-home" href="{{ site.link }}">Accueil</a>
				>
				<a class="a" id="atelier-breadcrumb-ateliers" href="{{ global.pageAteliers.link }}">{{ global.pageAteliers.title }}</a>
				>
				{{ post.name }}
			</div>
		</div>

		<div class="typeset pt-12.5 [&_h4]:mt-2.5">
			<h1>{{ post.title }}</h1>


			{{ post.content }}
			
			{% if evenements is not empty %}
				{% include 'partials/all-editions.twig' with {events: evenements} %}
			{% endif %}
		</div>

		
	</article>
{% endblock %}
