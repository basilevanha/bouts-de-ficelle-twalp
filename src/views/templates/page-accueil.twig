{% extends "layouts/base.twig" %}

{% set footerTone = 'secondary' %}

{# Variables disponibles :
	{{ dump(hero) }}
	{{ dump(actus) }}
	{{ dump(cours) }}
	{{ dump(ateliers) }}
 #}


{# Prepare datas #}
{% set heroDatas = {
	isHero: true,
	title: hero.titre,
	text: hero.texte,
	btns: hero.btns,
	negSurface: 'white'
} %}

{% set coursDatas = {
	title: cours.titre,
	text: cours.texte,
	btns: cours.btns
} %}

{% set ateliersDatas = {
	title: ateliers.infos.titre,
	text: ateliers.infos.texte,
	btns: [ateliers.infos.btn]
} %}

{% block main %}

	<div class="container flex flex-col gap-17.5" id="post-{{post.ID}}">

		{% include 'partials/image-text.twig' with {
			paragraphDatas: heroDatas,
			img: hero.img,
			revert: true,
			variant: "hero"
		} %}
		
		{% if (global.highlight.toggle == true) %}
			{% include 'modules/highlight.twig' with {title: actus.titre, event: global.highlight} %}
		{% endif %}


		{% include 'partials/image-text.twig' with {
			paragraphDatas: coursDatas,
			img: cours.img,
			variant: "cours"
		} %}

		{% include 'partials/text-liste.twig' with {
			paragraphDatas: ateliersDatas,
			items: ateliers.items,
			btnColor: 'secondary',
			class: 'band py-[120px] before:h-full before:bg-soft-secondary'
		} %}

	</div>
	<!-- /content-wrapper -->
{% endblock %}
