{% extends "layouts/base.twig" %}
{% set footerTone = 'secondary' %}

{# Variables disponibles :
	{{ dump(hero) }}
	{{ dump(groupe) }}
	{{ dump(equipe) }}
	{{ dump(archives) }}
 #}

{% set heroDatas = {
	paragraphDatas: {
		title: hero.titre,
		text: hero.texte
	},
	img: hero.img,
	isHero: true,
	ratioImg: 90
 } %}

 {% set equipeDatas = {
	title: equipe.titre,
	text: equipe.texte,
	btns: [
		{
			label: equipe.btn.label,
			url: equipe.btn.url,
		}
	]
 } %}

  {% set archivesDatas = {
	title: fichiers.titre,
	text: fichiers.texte,
	btn: fichiers.btn
 } %}


{% block main %}
	<div class="container flex flex-col" id="post-{{post.ID}}">
		
		{% include 'partials/image-text.twig' with heroDatas %}
		
		{% include 'atoms/image.twig' with {img: {
			src: groupe.url,
			alt: groupe.alt,
			ratio: 'banner'
		}} %}

		<div class="my-12.5 desktop:max-w-1/2">
			{% include 'modules/paragraph.twig' with equipeDatas %}
		</div>

    	{% include 'partials/members.twig' with {members: membres} %}
		
		<div class="band mt-[120px] py-[120px] before:h-full before:bg-soft-secondary [&_.typeset]:m-0 [&_.typeset]:mb-5">
			{% include 'modules/paragraph.twig' with archivesDatas %}

			{% include 'components/button.twig' with {
				label: archivesDatas.btn.label,
				href: archivesDatas.btn.url,
			} only %}
		</div>

	</div>
{% endblock %}
