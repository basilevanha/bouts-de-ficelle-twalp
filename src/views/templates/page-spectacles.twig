{% extends "layouts/base.twig" %}


{# Variables disponibles :
		{{ dump(hero) }}
		{{ dump(spectacles) }}
 #}

   {% set heroDatas = {
	paragraphDatas: {
		title: hero.titre,
		text: hero.texte,
		btns: [
			{
				label: hero.btn.label,
				url: hero.btn.url
			}
		]
	},
	revert: true,
	img: hero.img,
 } %}


{% block main %}
	<div class="container flex flex-col gap-17.5" id="post-{{post.ID}}">

		<div>
			{% include 'partials/image-text.twig' with heroDatas %}
		</div>

		{% if (global.highlight.toggle == true) and (global.highlight.type == 'spectacle') %}
			{% include 'modules/highlight.twig' with {title: 'Spectacle à la une', event: global.highlight} %}
		{% endif %}

		<div class="my-17.5">
			<h2 class="h2 mb-12.5">{{ liste.titre }}</h2>
			{% include 'partials/cards-list.twig' with {cards: spectacles, filters: filters, layout: 'grid'} %}
		</div>
	</div>
	<!-- /content-wrapper -->
{% endblock %}
