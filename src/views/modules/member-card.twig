{#
    img: imgObject
    name: string
    role: string
 #}

<div class="member-card relative mr-5 mb-5 flex w-full flex-col rounded-small border-3 border-dark bg-dark after:absolute after:top-5 after:left-5 after:-z-1 after:size-full after:rounded-small after:bg-secondary">
    {% include 'atoms/image.twig' with {img: {
        src: img.url,
        alt: img.alt,
        class: 'w-full overflow-hidden rounded-t-small'
    }} %}
    <div class="flex-1 rounded-b-small bg-light px-5 pt-5 pb-17.5 text-center">
        <p class="text-[1.375rem] font-bold">{{ name }}</p>
        <p>{{ role }}</p>
    </div>
</div>
