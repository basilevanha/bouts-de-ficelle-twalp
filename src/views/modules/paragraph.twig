{#
    {{ isHero }}
    {{ title }}
    {{ text }}
    {{ btns }}
    {{ btnColor }} = 'primary' | 'secondary' | 'tertiary'
    {{ negSurface }} = 'white' — background of the secondary (neg) buttons
 #}

<div class="paragraph flex flex-col gap-5">
    {% if isHero %}
        <h1 class="h1">{{ title }}</h1>
    {% else %}
        <h2 class="h2">{{ title }}</h2>
    {% endif %}
        {% if '<p>' in text %}
            <div class="typeset">
                {{ text }}
            </div>
        {% else %}
            <p>{{ text }}</p>
        {% endif %}

    {% if btns %}
        <div class="flex gap-5 max-desktop:flex-col">
            {% for btn in btns %}
                {% include 'components/button.twig' with {
                    label: btn.label,
                    href: btn.url,
                    style: loop.index > 1 ? 'neg' : 'default',
                    color: btnColor,
                    surface: loop.index > 1 ? negSurface : null
                } only %}
            {% endfor %}
        </div>
    {% endif %}
</div>
