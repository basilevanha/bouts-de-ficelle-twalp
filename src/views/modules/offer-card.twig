{#
    img, title, price, disclaimer, unit, schedule, number, calendar, btn
    color: 'primary' | 'secondary' | 'tertiary'
 #}

{% set tones = {
    primary: { shadow: 'after:bg-neg-primary', bubble: 'bg-soft-primary' },
    secondary: { shadow: 'after:bg-neg-secondary', bubble: 'bg-soft-secondary' },
    tertiary: { shadow: 'after:bg-neg-tertiary', bubble: 'bg-soft-tertiary' },
} %}
{% set tone = tones[color] ?? tones.primary %}
{% set bubble = 'flex gap-5 mb-2.5 rounded-small p-2.5 font-bold max-s:leading-[1.3] ' ~ tone.bubble %}

<div class="offer-card relative mr-5 mb-5 flex w-full flex-col rounded-small border-3 border-dark bg-dark after:absolute after:top-5 after:left-5 after:-z-1 after:size-full after:rounded-small {{ tone.shadow }}">
    {% include 'atoms/image.twig' with {img: {
        src: img.url,
        alt: img.alt,
        ratio: 'widescreen',
        class: 'w-full overflow-hidden rounded-t-small'
    }} %}

    <div class="flex flex-1 flex-col rounded-b-small bg-light p-2.5 s:p-5">
        <p class="h3 mb-5">{{ title }}</p>
        <p class="h1 mb-5 max-s:leading-[.8]">
            <span class="text-[1.875rem]">€ </span>
            {{ price }}
            {% if disclaimer %}
                <span class="font-normal">*</span>
            {% endif %}
            <span class="text-[1rem] whitespace-nowrap"> {{ unit }}</span> </p>
        <p class="{{ bubble }}">
            <span class="flex h-10 shrink-0 items-center">{{ icon('time', 'size-[35px]') }}</span>
            {{ schedule }}
        </p>
        <p class="{{ bubble }}">
            <span class="flex h-10 shrink-0 items-center">{{ icon('people', 'size-10') }}</span>
            {{ number }}
        </p>
        <p class="{{ bubble }}">
            <span class="flex h-10 shrink-0 items-center">{{ icon('calendar', 'size-10') }}</span>
            {{ calendar }}
        </p>
        {% if disclaimer %}
            <p class="my-2.5">
                * {{ disclaimer }}
            </p>
        {% endif %}
        <div class="mt-auto pt-5">
	    	{% include 'components/button.twig' with {href: btn.url, label: btn.label, color: 'dark', fullWidth: true} only %}
        </div>
    </div>
</div>
